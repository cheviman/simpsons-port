{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "The Simpsons Mr. Plow Edition",
  "repo": "cheviman/simpsons-port",
  "inputs": [
    {
      "id": "rom",
      "label": "Your arcade ROM set: MAME's simpsons set (4 Players World, set 1), as simpsons.zip, simpsons.7z or the folder with its files. MAME's other sets of the game have programs of their own and don't work.",
      "role": "game",
      "formats": [
        { "type": "file", "extensions": ["zip", "7z"] },
        { "type": "folder" }
      ]
    }
  ],
  "start": {
    "program": [
      "The Simpsons Mr. Plow Edition.exe",
      "The Simpsons Mr. Plow Edition",
      "The Simpsons Mr. Plow Edition.app/Contents/MacOS/The Simpsons Mr. Plow Edition"
    ],
    "args": ["--game={input:rom}"]
  },
  "prepare": {
    "program": [
      "The Simpsons Mr. Plow Edition.exe",
      "The Simpsons Mr. Plow Edition",
      "The Simpsons Mr. Plow Edition.app/Contents/MacOS/The Simpsons Mr. Plow Edition"
    ],
    "args": ["--prepare", "--game={input:rom}"],
    "label": "The game's graphics and sounds from your ROM set",
    "timeout": 120
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        { "path": "{install}/simpsons.ini", "if": "{install}/The Simpsons Mr. Plow Edition.exe" },
        { "path": "{install}/simpsons.ini", "if": "{install}/portable.txt" },
        { "path": "{home}/Library/Application Support/The Simpsons/simpsons.ini", "if": "{install}/The Simpsons Mr. Plow Edition.app" },
        { "path": "{local}/The Simpsons/simpsons.ini" }
      ]
    }
  ],
  "saves": [
    "{install}/simpsons.scores",
    "{install}/simpsons.state",
    "{install}/simpsons.nv",
    "{install}/simpsons.ini",
    "{install}/controls.ini",
    "{local}/The Simpsons/simpsons.scores",
    "{local}/The Simpsons/simpsons.state",
    "{local}/The Simpsons/simpsons.nv",
    "{local}/The Simpsons/simpsons.ini",
    "{local}/The Simpsons/controls.ini",
    "{home}/Library/Application Support/The Simpsons/simpsons.scores",
    "{home}/Library/Application Support/The Simpsons/simpsons.state",
    "{home}/Library/Application Support/The Simpsons/simpsons.nv",
    "{home}/Library/Application Support/The Simpsons/simpsons.ini",
    "{home}/Library/Application Support/The Simpsons/controls.ini"
  ],
  "folders": {
    "saves": [
      { "path": "{install}", "if": "{install}/The Simpsons Mr. Plow Edition.exe" },
      { "path": "{install}", "if": "{install}/portable.txt" },
      { "path": "{home}/Library/Application Support/The Simpsons", "if": "{install}/The Simpsons Mr. Plow Edition.app" },
      { "path": "{local}/The Simpsons" }
    ],
    "logs": [
      { "path": "{install}", "if": "{install}/The Simpsons Mr. Plow Edition.exe" },
      { "path": "{install}", "if": "{install}/portable.txt" },
      { "path": "{home}/Library/Application Support/The Simpsons", "if": "{install}/The Simpsons Mr. Plow Edition.app" },
      { "path": "{local}/The Simpsons" }
    ]
  },
  "actions": [
    { "id": "saves", "label": "Saves", "help": "The high scores, the pause's saved state, the settings, each player's controls and the logs of the last three runs.", "open": "saves" }
  ],
  "exit_codes": {
    "2": "The game's graphics and sounds couldn't be made from your copy. It has to be MAME's simpsons set (4 Players World, set 1): simpsons.zip, simpsons.7z, or the folder with its files. Pick it again on the game's page."
  },
  "looks": {
    "allowed": false,
    "reason": "The game has its own pixels in OPTIONS > VIDEO: sharp, smooth, bilinear and CRT."
  },
  "settings": [
    {
      "id": "window", "label": "Window", "group": "Video",
      "help": "Full screen fills your screen. F11 or Alt+Enter switches in the game too.",
      "choices": [
        { "label": "Window", "set": { "full_screen": "0" } },
        { "label": "Full screen", "set": { "full_screen": "1" } }
      ],
      "defaults": { "full_screen": "0" }
    },
    {
      "id": "window_size", "label": "Window size", "group": "Video",
      "help": "The window, in times the arcade's picture.",
      "choices": [
        { "label": "1x", "set": { "window_scale": "1" } },
        { "label": "2x", "set": { "window_scale": "2" } },
        { "label": "3x", "set": { "window_scale": "3" } },
        { "label": "4x", "set": { "window_scale": "4" } },
        { "label": "5x", "set": { "window_scale": "5" } },
        { "label": "6x", "set": { "window_scale": "6" } }
      ],
      "defaults": { "window_scale": "3", "full_screen": "0" },
      "when": { "full_screen": "0" }
    },
    {
      "id": "wide", "label": "Wide", "group": "Video",
      "help": "The stages drawn wider than the arcade's picture. Auto follows your screen's shape; Off is the cabinet's picture.",
      "choices": [
        { "label": "Auto", "set": { "wide": "auto" } },
        { "label": "Off", "set": { "wide": "off" } },
        { "label": "16:10", "set": { "wide": "16:10" } },
        { "label": "16:9", "set": { "wide": "16:9" } },
        { "label": "20:9", "set": { "wide": "20:9" } }
      ],
      "defaults": { "wide": "auto" }
    },
    {
      "id": "pixels", "label": "Pixels", "group": "Video",
      "help": "Sharp keeps the arcade's pixels crisp, smooth and bilinear soften them, CRT draws an arcade monitor's lines. F3 switches in the game too.",
      "choices": [
        { "label": "Sharp", "set": { "pixels": "sharp" } },
        { "label": "Smooth", "set": { "pixels": "smooth" } },
        { "label": "Bilinear", "set": { "pixels": "bilinear" } },
        { "label": "CRT", "set": { "pixels": "crt" } }
      ],
      "defaults": { "pixels": "sharp" }
    },
    {
      "id": "integer_scale", "label": "Integer scale", "group": "Video",
      "help": "The picture a whole number of times its pixels, so every pixel is the same size, with a border around it.",
      "choices": [
        { "label": "Off", "set": { "integer_scale": "0" } },
        { "label": "On", "set": { "integer_scale": "1" } }
      ],
      "defaults": { "integer_scale": "0" }
    },
    {
      "id": "vsync", "label": "V-Sync", "group": "Video",
      "help": "Each frame shown at your screen's refresh, with no tearing.",
      "choices": [
        { "label": "On", "set": { "vsync": "1" } },
        { "label": "Off", "set": { "vsync": "0" } }
      ],
      "defaults": { "vsync": "1" }
    },
    {
      "id": "fps", "label": "Show FPS", "group": "Video",
      "help": "The frames a second at the picture's top right.",
      "choices": [
        { "label": "Off", "set": { "fps": "0" } },
        { "label": "On", "set": { "fps": "1" } }
      ],
      "defaults": { "fps": "0" }
    },
    {
      "id": "volume", "label": "Volume", "group": "Sound",
      "help": "The game's volume. 5 is the arcade's own.",
      "slider": { "key": "volume", "min": 0, "max": 10, "step": 1, "format": "%d" },
      "defaults": { "volume": "5" }
    },
    {
      "id": "sound", "label": "Sound", "group": "Sound",
      "help": "Mono, as the cabinet is wired, or stereo: the music's channels where the game pans them.",
      "choices": [
        { "label": "Mono", "set": { "sound": "mono" } },
        { "label": "Stereo", "set": { "sound": "stereo" } }
      ],
      "defaults": { "sound": "mono" }
    },
    {
      "id": "demo_sound", "label": "Demo sound", "group": "Sound",
      "help": "The sound while the game shows itself between games, as the cabinet's setting.",
      "choices": [
        { "label": "On", "set": { "demo_sound": "1" } },
        { "label": "Off", "set": { "demo_sound": "0" } }
      ],
      "defaults": { "demo_sound": "1" }
    },
    {
      "id": "difficulty", "label": "Difficulty", "group": "Game",
      "help": "The cabinet's difficulty setting.",
      "choices": [
        { "label": "Easy", "set": { "difficulty": "easy" } },
        { "label": "Normal", "set": { "difficulty": "normal" } },
        { "label": "Difficult", "set": { "difficulty": "difficult" } },
        { "label": "Very difficult", "set": { "difficulty": "very difficult" } }
      ],
      "defaults": { "difficulty": "normal" }
    },
    {
      "id": "lives", "label": "Lives", "group": "Game",
      "help": "The lives a player starts ARCADE with.",
      "slider": { "key": "lives", "min": 1, "max": 7, "step": 1, "format": "%d" },
      "defaults": { "lives": "2" }
    },
    {
      "id": "continues", "label": "Continues", "group": "Game",
      "help": "How many times each player can continue in ARCADE.",
      "choices": [
        { "label": "0", "set": { "continues": "0" } },
        { "label": "1", "set": { "continues": "1" } },
        { "label": "2", "set": { "continues": "2" } },
        { "label": "3", "set": { "continues": "3" } },
        { "label": "4", "set": { "continues": "4" } },
        { "label": "5", "set": { "continues": "5" } },
        { "label": "6", "set": { "continues": "6" } },
        { "label": "7", "set": { "continues": "7" } },
        { "label": "8", "set": { "continues": "8" } },
        { "label": "9", "set": { "continues": "9" } },
        { "label": "Unlimited", "set": { "continues": "unlimited" } }
      ],
      "defaults": { "continues": "3" }
    },
    {
      "id": "bart_shirt", "label": "Colours", "group": "Game",
      "help": "Bart's shirt orange, as on the show, and Barney's salmon; or the arcade's light blue and green.",
      "choices": [
        { "label": "The show's", "set": { "bart_shirt": "orange" } },
        { "label": "The arcade's", "set": { "bart_shirt": "arcade" } }
      ],
      "defaults": { "bart_shirt": "orange" }
    }
  ]
}
